						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"model\": \"rerank-english-v2.0\",\n    \"query\": \"What is the capital of the United States?\",\n    \"documents\": [\n        \"The capital of the United States is Washington, D.C.\",\n        \"The capital of France is Paris.\"\n    ],\n    \"top_n\": 1,\n    \"return_documents\": true\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseURL}}/v1/rerank",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"v1",
						"rerank"
					]
				}
			},
			"response": []
		},
